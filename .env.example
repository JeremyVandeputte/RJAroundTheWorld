# RJ Around The World - configuration
# Copy this file to `.env` and fill in the two secrets.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Required secrets -------------------------------------------------------

# Secret used to protect sessions. At least 32 characters. Never share it.
SESSION_SECRET=

# Token of the secret link (https://your-site/access/<ACCESS_TOKEN>).
# At least 32 characters, letters, digits, "-" and "_" only.
# Changing it invalidates the old link for everyone.
ACCESS_TOKEN=

# --- Optional (defaults shown) ----------------------------------------------

# Public URL of the site, without trailing slash. Must be https in production.
APP_URL=http://localhost:3000

# SQLite database file.
DATABASE_PATH=./data/rjaroundtheworld.db

# Folder where photos and videos are stored. Must stay outside `public/`.
MEDIA_DIR=./data/media

# Upload limits.
MAX_PHOTO_MB=10
MAX_VIDEO_MB=300
MEDIA_QUOTA_GB=30

# Session lifetime, in days.
SESSION_DAYS=30

# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
